# ---------------------------------------------------------------------------
# AIO-AgentOS 环境变量样例
#
# 所有变量都有安全默认值，本地开发可以只复制这个文件为 .env 后直接启动。
# 生产环境请务必设置 AIO_AGENTOS_ENV=production 并配置下面两项密钥，
# 否则 /healthz 的 security_warnings 会列出风险项。
# ---------------------------------------------------------------------------

# --- 运行环境 ---
AIO_AGENTOS_ENV=development
AIO_AGENTOS_ALLOW_INSECURE=false

# --- 鉴权 ---
# 设置后所有 API 端点必须携带 X-API-Key
AIO_AGENTOS_API_KEY=change-me
# 设置后审批端点必须额外携带 X-Approver-Key
AIO_AGENTOS_APPROVER_KEY=change-approver-key

# --- LLM ---
# deterministic（默认，无需凭据）| openai | deepseek | langchain
AIO_AGENTOS_LLM_PROVIDER=deterministic
AIO_AGENTOS_LLM_MODEL=deterministic-rule-v1
# 切换到真实 provider 时必填
# AIO_AGENTOS_LLM_API_KEY=sk-xxx
AIO_AGENTOS_LLM_BASE_URL=https://api.deepseek.com/v1
AIO_AGENTOS_LLM_TIMEOUT_SECONDS=30
AIO_AGENTOS_LLM_MAX_RETRIES=2

# --- 编排 ---
# 审批超时后默认拒绝
AIO_AGENTOS_APPROVAL_TIMEOUT_SECONDS=86400
AIO_AGENTOS_REASONING_TIMEOUT_SECONDS=120
AIO_AGENTOS_MAX_GRAPH_STEPS=24

# --- 横切能力 ---
AIO_AGENTOS_RATE_LIMIT_PER_MINUTE=120
AIO_AGENTOS_RATE_LIMIT_BURST=30
AIO_AGENTOS_CACHE_TTL_SECONDS=30
AIO_AGENTOS_CACHE_MAX_ENTRIES=512
AIO_AGENTOS_RESOURCE_LOCK_TIMEOUT_SECONDS=10
AIO_AGENTOS_TOOL_CIRCUIT_THRESHOLD=3
AIO_AGENTOS_TOOL_CIRCUIT_COOLDOWN_SECONDS=30

# --- 持久化 ---
# memory（默认，重启即丢）| sqlite（跨重启保留）
AIO_AGENTOS_STORE_BACKEND=memory
AIO_AGENTOS_SQLITE_PATH=aio_agentos.db

# --- 可观测 ---
# AIO_AGENTOS_TRACE_EXPORT_PATH=./var/traces.jsonl
# AIO_AGENTOS_BADCASE_EXPORT_PATH=./var/badcases.jsonl

# --- 协议 ---
AIO_AGENTOS_A2A_ENDPOINT=http://localhost:8000

# --- Temporal（仅生产编排需要）---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aio-agentos
